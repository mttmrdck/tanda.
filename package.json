{
  "name": "tanda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personalised, on-device communication aid for non-verbal children.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https --host",
    "predev": "node scripts/setup-assets.mjs --if-missing",
    "predev:https": "node scripts/setup-assets.mjs --if-missing",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/setup-assets.mjs --if-missing",
    "preview": "vite preview",
    "prepreview": "node scripts/setup-assets.mjs --if-missing",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "pree2e": "node scripts/setup-assets.mjs --if-missing && tsc -b && vite build --mode e2e",
    "setup": "node scripts/setup-assets.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run lint && npm run contrast && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "~0.10.35",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
